# ==============================================================================
# InkShift Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Settings
# ------------------------------------------------------------------------------
INKSHIFT_HOST=127.0.0.1
INKSHIFT_PORT=8000
INKSHIFT_DEFAULT_ENGINE=local       # Options: "local" (zero-cost offline default), "cloud", "mock"
INKSHIFT_DB_PATH=./data/cache.db
INKSHIFT_MAX_PAYLOAD_SIZE=20000000

# ------------------------------------------------------------------------------
# 2. Cloud Vision Hub (Optional - For High-Accuracy Cloud Multimodal Translation)
# To use Cloud Mode: Set INKSHIFT_DEFAULT_ENGINE=cloud and insert your API key below
# ------------------------------------------------------------------------------
# Tier 1: Google AI Studio (Gemini)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Tier 2: OpenAI Official
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Tier 3: Anthropic Claude
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Tier 4: Custom OpenAI-Compatible (Ollama, vLLM, DeepSeek, OpenRouter, etc.)
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=https://api.openai.com/v1

# Active Default Cloud Provider ("google", "openai", "anthropic", "custom")
INKSHIFT_CLOUD_PROVIDER=google
INKSHIFT_CLOUD_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 3. Local Engine Settings (Offline Processing)
# ------------------------------------------------------------------------------
INKSHIFT_LOCAL_MODEL_DIR=./.cache/inkshift/models
INKSHIFT_LOCAL_DEFAULT_OCR=auto                     # "auto", "manga-ocr", "rapidocr"
INKSHIFT_LOCAL_DEFAULT_TRANSLATOR=google-free       # "google-free", "llm-google", "llm-openai", "llm-anthropic", "llm-custom"
INKSHIFT_LOCAL_EXECUTION_PROVIDER=directml          # "directml" (DirectX 12 GPU on Windows), "cpu"

# ------------------------------------------------------------------------------
# 4. Logging & Telemetry
# ------------------------------------------------------------------------------
INKSHIFT_LOG_LEVEL=WARNING                          # "DEBUG", "INFO", "WARNING", "ERROR"
INKSHIFT_LOG_DIR=./data/logs
